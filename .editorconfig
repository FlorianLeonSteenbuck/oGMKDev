# ogmkdev dogfoods its own configuration format: EditorConfig is the only config file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{php,mustache.html,twig.html}]
ogmkdev_language = php
